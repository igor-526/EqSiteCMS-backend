ENVIRONMENT=development
DEBUG=true

SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

SECRET_KEY=<generate-a-random-jwt-secret>
SERVICE_KEY=<generate-a-random-service-key>
POSTGRES_USER=eqsitecms
POSTGRES_PASSWORD=<set-database-password>
POSTGRES_HOST=db
POSTGRES_NAME=eqsitecms
POSTGRES_PORT=5432

# Database Connection Pool Configuration
# Baseline connections: default 20
DB_POOL_SIZE=20
# Burst capacity: default 10
DB_MAX_OVERFLOW=10
# Max wait for connection in seconds: default 30
DB_POOL_TIMEOUT=30
# Force-close connections older than N seconds: default 3600 (1 hour)
DB_POOL_RECYCLE=3600
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=<set-object-storage-access-key>
S3_SECRET_KEY=<set-object-storage-secret-key>
S3_BUCKET_NAME=gallery
CMS_PANEL_DOMAIN=localhost:3001
CMS_BACKEND_DOMAIN=localhost:8000
CMS_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
EXPOSE_APP_PORT=8000

# VK Service (приватный сервис внутри eqsitecms_network)
VK_SERVICE_URL=http://eqsitecms-vk-service:8000
